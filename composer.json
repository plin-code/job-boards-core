{
    "name": "plin-code/job-boards-core",
    "description": "Framework agnostic contracts, DTOs and HTTP helpers shared by every plin-code job board connector",
    "keywords": [
        "PlinCode",
        "plin-code",
        "job-boards",
        "job-board",
        "ats",
        "scraping",
        "psr-18"
    ],
    "homepage": "https://github.com/plin-code/job-boards-core",
    "license": "MIT",
    "authors": [
        {
            "name": "Daniele Barbaro",
            "email": "barbaro.daniele@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1||^2.0",
        "psr/log": "^2.0||^3.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.8",
        "laravel/pint": "^1.14",
        "pestphp/pest": "^3.0||^4.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "PlinCode\\JobBoards\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PlinCode\\JobBoards\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "check": [
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "suggest": {
        "guzzlehttp/guzzle": "To use PlinCode\\JobBoards\\Http\\GuzzleTimeoutClient, which makes per-call timeouts take effect, and the PSR-18 test doubles under PlinCode\\JobBoards\\Testing."
    }
}
